params {
    // Input
    reads = '/Users/nataliemarryatt/RNAseq-nextflow/test-datasets/testdata/*_subsamp.fastq.gz'

    // Reference files
    salmon_index = "/Users/nataliemarryatt/RNAseq-nextflow/test-datasets/reference/salmon"
    transcriptome_fasta= '/Users/nataliemarryatt/RNAseq-nextflow/test-datasets/reference/transcriptome.fasta'
    genome_fasta = "/Users/nataliemarryatt/RNAseq-nextflow/test-datasets/reference/genome.fa"  
    gff = "/Users/nataliemarryatt/RNAseq-nextflow/test-datasets/reference/genes.gff"

    // Output
    outdir = '/Users/nataliemarryatt/RNAseq-nextflow/results'

    // Workflow options
    build_salmon_index = false
    build_star_index = true
    skip_fastqc = false
    skip_multiqc = false

    // Tool-specific parameters
    salmon_kmer = 31
    star_genomeSAindexNbases = 7
    
    // Resource defaults
    max_cpus = 8
    max_memory = '16.GB'
    max_time = '24.h'
}

conda {
    enabled = true
    useMamba = false
}

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: fastqc {
        conda = 'bioconda::fastqc=0.12.1'
    }
    withName: 'salmon_index'{
        conda= 'bioconda::salmon'
    }
    withName: 'salmon_quant'{
        conda= 'bioconda::salmon'
    }
    withName: multiqc {
        conda = 'bioconda::multiqc=1.14'
    }

    withName: 'star_index|star_align' {
        container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_1'
    }
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/execution_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/timeline.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/trace.txt"
    // Note: CPU/memory metrics require Docker on macOS
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_dag.html"
}